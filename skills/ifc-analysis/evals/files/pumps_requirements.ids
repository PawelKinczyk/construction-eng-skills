      <applicability minOccurs="1" maxOccurs="unbounded"><entity><name><simpleValue>IFCPUMP</simpleValue></name></entity></applicability>
      <requirements><property dataType="IFCREAL" cardinality="required"><propertySet><simpleValue>Pset_FlowMoverCommon</simpleValue></propertySet><baseName><simpleValue>RatedPower</simpleValue></baseName></property></requirements>
    </specification>
  </specifications>
